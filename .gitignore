# ==========================================
# SpendMate AI — Comprehensive .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Secrets (Keep confidential)
.env
.env.*
*.env
!.env.example
!*/.env.example

# Production Build Outputs
dist/
build/
*/dist/
*/build/
.output/

# Cache & Temp Files
.cache/
.vite/
*/.vite/
.eslintcache
*.tsbuildinfo
.temp/
.tmp/
mongodb-memory-server/

# Runtime Logs
logs/
*.log

# Editor & IDE Directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
