# ===================================================
# SpendMate AI — Root Environment Template
# ===================================================

# -----------------
# Backend Config (backend/.env)
# -----------------
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/spendmate_ai

# JWT Authentication Secret & Token Lifespan
JWT_SECRET=spendmate_ai_jwt_secret_key_production_grade_super_secure_2026
JWT_EXPIRE=30d

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Optional: Google Gemini API Key for Live AI Advisor Generation
# (If omitted, SpendMate AI automatically utilizes its built-in Smart Heuristic Financial Engine)
GEMINI_API_KEY=

# -----------------
# Frontend Config (frontend/.env)
# -----------------
# Optional: Set this when deploying frontend and backend to separate domains (e.g. Vercel & Render)
# VITE_API_URL=https://spendmate-backend.onrender.com

